<article class="detalle-mascota">
  <header class="cabecera-detalle">
    <h1><%= mascota.nombre %></h1>
    <span class="etiqueta"><%= mascota.especie %></span>
  </header>

  <div class="contenido-detalle">    
    <img src="<%= mascota.imagen %>" alt="fotografia de <%= mascota.nombre %>, un <%= mascota.especie %> en adopcion" class="imagen-mascota" />

    <div class="info-mascota">
      <p><strong>Edad:</strong> <%= mascota.edad === 0 ? 'Menos de 1 año' : mascota.edad + (mascota.edad === 1 ? ' año' : ' años') %></p>
      <p><strong>Estado:</strong> <span class="estado-badget"><%= mascota.estado %></span></p>
      <p><strong>Descripcion:</strong> <%= mascota.descripcion %></p>
    </div>
  </div>
  
  <footer class="acciones-detalle">
    <a href="/mascotas" class="boton-secundario">← Volver al listado</a>
  </footer>
</article>