<section class="pagina-formulario">
  <header class="cabecera-pagina">
    <div>
      <p class="etiqueta">REGISTRO</p>
      <h1>Cargar nueva mascota</h1>
    </div>
  </header>

  <% if (typeof error !== "undefined" && error) { %>
    <div role="alert"><%= error %></div>
  <% } %>

  <form action="/mascotas" method="post" class="formulario-mascota">
    <div class="campo">
      <label for="nombre">Nombre</label>
      <input type="text" id="nombre" name="nombre" value="<%= typeof mascota !== 'undefined' ? mascota.nombre || '' : '' %>" required />
    </div>

    <div class="campo">
      <label for="especie">Especie</label>
      <select id="especie" name="especie" required>
        <option value="">Seleccione una especie</option>
        <option value="perro" <%= typeof mascota !== 'undefined' && mascota.especie === 'perro' ? 'selected' : '' %>>Perro</option>
        <option value="gato" <%= typeof mascota !== 'undefined' && mascota.especie === 'gato' ? 'selected' : '' %>>Gato</option>
      </select>
    </div>

    <div class="campo">
      <label for="edad">Edad</label>
      <input type="number" id="edad" name="edad" value="<%= typeof mascota !== 'undefined' ? mascota.edad ?? '' : '' %>" required />
    </div>

    <div class="campo">
      <label for="estado">Estado</label>
      <select id="estado" name="estado" required>
        <option value="">Seleccione un estado</option>
        <option value="En adopción" <%= typeof mascota !== 'undefined' && mascota.estado === 'En adopción' ? 'selected' : '' %>>En adopción</option>
        <option value="Reservada" <%= typeof mascota !== 'undefined' && mascota.estado === 'Reservada' ? 'selected' : '' %>>Reservada</option>
        <option value="Adoptada" <%= typeof mascota !== 'undefined' && mascota.estado === 'Adoptada' ? 'selected' : '' %>>Adoptada</option>
      </select>
    </div>

    <div class="campo">
      <label for="descripcion">Descripción</label>
      <textarea id="descripcion" name="descripcion" rows="5" required><%= typeof mascota !== 'undefined' ? mascota.descripcion || '' : '' %></textarea>
    </div>

    <div class="acciones-formulario">
      <button type="submit" class="boton">Guardar mascota</button>
      <a href="/mascotas" class="boton-secundario">Volver</a>
    </div>
  </form>
</section>
